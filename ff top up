/* MENU */

.menu {
    display: flex;
    overflow-x: auto;
    gap: 10px;
    padding: 15px;
    background: #0d0d13;
}

.menu button {
    min-width: 130px;
    padding: 12px;
    border: 1px solid #7b2cff;
    border-radius: 25px;
    background: #17131f;
    color: white;
    font-weight: bold;
}

/* CONTAINER */

.container {
    max-width: 600px;
    margin: auto;
    padding: 15px;
}

/* TITRE */

.section-title {
    font-size: 25px;
    font-weight: bold;
    margin: 30px 0 15px;
}

/* CARTE */

.card {
    background: linear-gradient(145deg, #15151e, #20202c);
    border: 1px solid #29293a;
    border-radius: 18px;
    padding: 18px;
    margin-bottom: 13px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.4);
}

.card:hover {
    border-color: #8b3dff;
}

.card h3 {
    margin: 0 0 10px;
}

.diamonds {
    color: #55c7ff;
    font-size: 21px;
    font-weight: bold;
}

.price {
    font-size: 19px;
    font-weight: bold;
    color: #ffd52f;
}

/* BOUTON */

.order {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 12px;
    background: linear-gradient(90deg, #7b2cff, #b22cff);
    color: white;
    font-size: 17px;
    font-weight: bold;
}

.order:active {
    transform: scale(0.97);
}

/* FORMULAIRE */

.form {
    background: #15151e;
    padding: 20px;
    border-radius: 18px;
    margin-top: 30px;
}

input, select {
    width: 100%;
    padding: 14px;
    margin: 8px 0 15px;
    border: 1px solid #333;
    border-radius: 10px;
    background: #0d0d13;
    color: white;
    font-size: 16px;
}

/* MESSAGE */

#message {
    display: none;
    margin-top: 15px;
    padding: 15px;
    border-radius: 12px;
    background: #12351f;
    color: #70ff9b;
    text-align: center;
}

/* FOOTER */

footer {
    text-align: center;
    padding: 30px 15px;
    margin-top: 30px;
    background: #101016;
    color: #888;
}

</style>
</head>

